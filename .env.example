CISP_ENDPOINT=https://cisp.zenitera.com
CISP_REQUEST_URI=/ectcispserver/api/entcreditapi/query
# Optional dedicated proxy for CISP requests, for example:
# CISP_ENDPOINT_PROXY=http://proxy.example.internal:8080
# Required only for local stdio mode. Streamable HTTP clients send their own
# key as: Authorization: Bearer <CISP_API_KEY>
CISP_API_KEY=replace-with-your-api-key
CISP_TIMEOUT_SECONDS=30
CISP_VERIFY_SSL=true
